rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 🛡️ فحص هل المستخدم محظور أم لا بأمان تام
    function isNotBanned() {
      return request.auth == null || 
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'deleted';
    }

    // 👑 فحص صلاحيات الأدمن والمالك
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'moazsamh8@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner'))
      );
    }

    // 👥 1. المستخدمين والملفات الشخصية وتوكن الإشعارات
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // 📍 2. الأماكن والمحلات
    match /places/{placeId} {
      allow read: if true;
      allow write: if isNotBanned() || isAdmin();
    }

    // 🏷️ 3. التصنيفات والفلاتر
    match /categories/{catId} {
      allow read: if true;
      allow write: if true;
    }

    // 📰 4. الأخبار والتصويتات والتعليقات
    match /news/{newsId} {
      allow read: if true;
      allow write: if isNotBanned() || isAdmin();
    }

    // 💬 5. غرف ورسائل الشات اللحظية
    match /{chatCollection}/{messageId} {
      allow read, write: if chatCollection.matches('chat_.*');
    }

    // 🎓 6. الكورسات والدورات التدريبية
    match /courses/{courseId} {
      allow read: if true;
      allow write: if true;
    }

    // 🤝 7. الفعاليات والتطوع
    match /events/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    // 🔍 8. بلاغات المفقودين
    match /missing_reports/{reportId} {
      allow read: if true;
      allow write: if isNotBanned() || isAdmin();
    }

    // 🛠️ 9. الخدمات والعقارات والإعلانات
    match /online_services/{serviceId} {
      allow read: if true;
      allow write: if isNotBanned() || isAdmin();
    }
    match /real_estate/{estateId} {
      allow read: if true;
      allow write: if isNotBanned() || isAdmin();
    }
    match /ads/{adId} {
      allow read: if true;
      allow write: if true;
    }

    // ⚙️ 10. إعدادات الموقع وترتيب الفلاتر
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // 🚨 11. البلاغات والإشراف المجتمعي
    match /comment_reports/{reportId} {
      allow read, write: if true;
    }
    match /deleted_comments/{commentId} {
      allow read, write: if true;
    }
    match /admin_notifications/{notifId} {
      allow read, write: if true;
    }

    // 🌐 12. القاعدة العامة الاحتياطية
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
